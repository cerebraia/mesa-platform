    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/pricing.test.ts",
    "test:db": "node --experimental-strip-types --env-file=.env.local --env-file=.env.test --test tests/db-isolation.test.ts",
    "test:catalog": "node --experimental-strip-types --env-file=.env.local --env-file=.env.test --test tests/catalog-isolation.test.ts",
    "test:config": "node --experimental-strip-types --env-file=.env.local --env-file=.env.test --test tests/config-isolation.test.ts",
    "test:orders": "node --experimental-strip-types --env-file=.env.local --env-file=.env.test --test tests/orders-isolation.test.ts",
    "test:panel": "node --experimental-strip-types --env-file=.env.local --env-file=.env.test --test tests/panel-orders.test.ts",
    "test:improvements": "node --experimental-strip-types --env-file=.env.local --env-file=.env.test --test tests/order-improvements.test.ts",
    "test:admin": "node --experimental-strip-types --env-file=.env.local --env-file=.env.test --test tests/admin.test.ts",
    "test:domains": "node --experimental-strip-types --env-file=.env.local --env-file=.env.test --test tests/domains.test.ts",
