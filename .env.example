# Mesa Platform — Variables de entorno
# Copiar a .env.local y completar los valores.
# Nunca añadir valores reales a este archivo ni al repositorio.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Crear un proyecto exclusivo para Mesa en https://supabase.com
# Encontrar los valores en: Project Settings → API

# URL pública del proyecto (visible en el cliente, se incorpora al build).
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (pública). Llamada 'anon key' en versiones anteriores.
# Permite operaciones dentro de las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave de servicio (privada). NUNCA usar en código de cliente ni en el navegador.
# Solo para operaciones privilegiadas en el servidor: Auth Admin API, seeds.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sitio ──────────────────────────────────────────────────────────────────────
# URL completa del sitio, incluye https://. Usada para:
#   - Invitaciones de Supabase Auth (redirectTo)
#   - Construcción de URLs absolutas en correos y webhooks
# Formato: https://mesa.app  (sin barra final)
NEXT_PUBLIC_SITE_URL=

# ── Hosts de plataforma ────────────────────────────────────────────────────────
# Controlan el routing por hostname (src/proxy.ts).
# En localhost estas variables no son necesarias.

# Dominio principal del sitio comercial y panel (ej. mesa.app).
# En Railway staging: el hostname temporal asignado, ej. mesa-platform-xyz.up.railway.app
NEXT_PUBLIC_PLATFORM_HOST=

# Host alternativo del panel si es distinto al principal. Si no se define,
# se hereda de NEXT_PUBLIC_PLATFORM_HOST.
NEXT_PUBLIC_APP_HOST=

# Base para subdominios de restaurante (ej. menus.mesa.app → restaurante-alfa.menus.mesa.app).
# Puede ser el mismo dominio principal (mesa.app) o un subdominio específico para menús.
# Reservados rechazados: www app admin api panel mail auth dashboard help status blog docs
# Requiere:
#   1. wildcard DNS  *.VALOR → CNAME al host de Railway
#   2. dominio wildcard añadido en Railway → Settings → Domains
# Dejar vacío para deshabilitar subdominios de restaurante.
PLATFORM_SUBDOMAIN_BASE=

# ── Base de datos (solo para scripts de migraciones y seeds) ──────────────────
# URL de conexión directa al proyecto Supabase. NO usar en la aplicación.
# Usada únicamente por: supabase db push, scripts de seed en local.
# MESA_DATABASE_URL=
