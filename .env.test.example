# Credenciales de usuarios de prueba para tests de aislamiento RLS.
# Copiar a .env.test (gitignoreado) y completar los valores.
#
# Crear estos usuarios en: Supabase Dashboard → Authentication → Users → New user
# Anotar el UUID de cada usuario para el seed.
# Las contraseñas deben ser distintas entre usuarios y no usarse en producción.

TEST_ADMIN_EMAIL=admin@test.mesa
TEST_ADMIN_PASSWORD=

TEST_OWNER_ALFA_EMAIL=owner-alfa@test.mesa
TEST_OWNER_ALFA_PASSWORD=

TEST_OWNER_BETA_EMAIL=owner-beta@test.mesa
TEST_OWNER_BETA_PASSWORD=

TEST_ATTENTION_ALFA_EMAIL=attention-alfa@test.mesa
TEST_ATTENTION_ALFA_PASSWORD=

TEST_KITCHEN_ALFA_EMAIL=kitchen-alfa@test.mesa
TEST_KITCHEN_ALFA_PASSWORD=

TEST_NOACCESS_EMAIL=noaccess@test.mesa
TEST_NOACCESS_PASSWORD=

# UUIDs de cada usuario (copiar desde el dashboard después de crearlos).
# Necesarios para completar supabase/seeds/test_seed.sql.
TEST_ADMIN_UUID=
TEST_OWNER_ALFA_UUID=
TEST_OWNER_BETA_UUID=
TEST_ATTENTION_ALFA_UUID=
TEST_KITCHEN_ALFA_UUID=
TEST_NOACCESS_UUID=
